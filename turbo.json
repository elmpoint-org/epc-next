{
  "$schema": "https://v2-7-6.turborepo.dev/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"],
  "tasks": {
    "gql:pregen": {
      "inputs": [
        "$TURBO_ROOT$/apps/server/src/db/**",
        "!$TURBO_ROOT$/apps/server/src/db/**/__types"
      ],
      "outputs": ["src/db/**/__types/**"]
    },
    "gql:gen": {
      "inputs": [
        "$TURBO_ROOT$/apps/server/src/db/**",
        "!$TURBO_ROOT$/apps/server/src/db/**/__types"
      ],
      "outputs": ["graphql-schema.d.ts"],
      "dependsOn": ["@epc/schema#gql:pregen"]
    },
    "test": {
      "dependsOn": ["gql:gen"]
    },
    "build": {},
    "dev:gql": {
      "cache": false,
      "persistent": true
    },
    "dev:email": {
      "cache": false,
      "persistent": true
    },
    "//#dev:sst": {
      "cache": false,
      "persistent": true,
      "interactive": false
    },
    "dev-client": {
      "cache": false,
      "persistent": true,
      "with": ["dev:gql"]
    }
  }
}
