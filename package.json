{
  "name": "epc",
  "private": true,
  "scripts": {
    "tr": "turbo run",
    "postinstall": "turbo gql:pregen gql:gen",
    "gql:gen": "turbo gql:gen",
    "test": "turbo test",
    "build": "turbo build",
    "push": "sst deploy",
    "dev": "turbo dev:sst dev:gql",
    "dev-client": "turbo dev-client",
    "dev-email": "turbo dev:email",
    "dev:sst": "sst dev --stage=development --mode=mono",
    "dev:unlock": "sst unlock --stage=development"
  },
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "sst": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.149",
    "turbo": "^2.11.11",
    "typescript": "catalog:"
  }
}
